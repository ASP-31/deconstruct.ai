# Required: Google Gemini API
GEMINI_API_KEY=your_actual_api_key_here

# Required for >4MB uploads: Vercel Blob (auto-created in Vercel Dashboard)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# Optional: Upstash Redis for global rate limiting (falls back to memory if unset)
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token
# Legacy alias accepted for the REST URL (must start with https://)
REDIS_URL=https://your-db.upstash.io

# Optional: Neon Postgres for analysis cache (Layer 2).
# If unset, app still works — cache is skipped and Gemini is called every time.
# Create free DB at https://console.neon.tech, then run: psql $DATABASE_URL -f lib/db/schema.sql
DATABASE_URL=postgresql://user:pass@host/db
